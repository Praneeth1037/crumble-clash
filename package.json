{
  "name": "crumble-clash",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Two-player hex-tile survival on three crumbling floors. Local split-screen and private online rooms.",
  "scripts": {
    "dev": "tsx server/index.ts",
    "client": "vite",
    "build": "tsc --noEmit && vite build",
    "start": "NODE_ENV=production tsx server/index.ts",
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "test:browser": "tsx tests/browser.ts"
  },
  "engines": { "node": ">=20" },
  "dependencies": {
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "three": "0.187.0",
    "tsx": "^4.23.15",
    "ws": "^8.22.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.1",
    "@types/node": "^22.15.30",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/three": "^0.183.1",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.9.3",
    "vite": "^6.4.5",
    "vitest": "^5.1.0"
  }
}
